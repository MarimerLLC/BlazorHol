@page "/counter"
@rendermode InteractiveAuto

@using BlazorRenderModes.Services

@inject Services.RenderModeProvider RenderModeProvider

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p class="border border-info">Render mode: 
    @RenderModeProvider.GetRenderMode(this)</p>

@if (data == null)
{
    <p>Really Loading...</p>
}
else
{
    @if (RenderModeProvider.GetRenderMode(this).IsInteractive())
    {
        <p>@data</p>

        <p role="status">Current count: @currentCount</p>

        <button class="btn btn-primary" @onclick="IncrementCount">Click me</button>
    }
    else
    {
        <p>Sorry, this page is not interactive.</p>
    }
}

@code {
    private int currentCount = 0;
    private string? data;

    protected override async Task OnInitializedAsync()
    {
        if (!RenderModeProvider.GetRenderMode(this).IsInteractive())
        {
            // go get data from the database!!!!!!

                // display data

            // put data into persistent storage
        }
        else
        {
            // get data from persistent storage

            //display data

            await Task.Delay(1000);
            data = "";
        }
    }

    private void IncrementCount()
    {
        currentCount++;
    }
}
