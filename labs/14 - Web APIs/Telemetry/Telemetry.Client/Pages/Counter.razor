@page "/counter"
@rendermode InteractiveAuto
@using Microsoft.Extensions.Logging
@using Telemetry.Client.Observability
@inject ILogger<Counter> Logger

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p>
    This component uses <code>InteractiveAuto</code>, so it runs on the server at first and in
    WebAssembly once the runtime has been downloaded. The same telemetry code reports to
    <code>blazor-server</code> or <code>blazor-wasm</code> depending on where it is running.
</p>

<p>Running on: <strong>@RendererInfo.Name</strong>@(RendererInfo.IsInteractive ? "" : " (not interactive yet)")</p>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        // RendererInfo.Name is "Server" or "WebAssembly" for an interactive component
        var renderMode = RendererInfo.Name;
        var tag = new KeyValuePair<string, object?>("blazor.render_mode", renderMode);

        using var activity = ClientDiagnostics.ActivitySource.StartActivity("Increment counter");
        activity?.SetTag(tag.Key, tag.Value);

        currentCount++;

        activity?.SetTag("counter.value", currentCount);
        ClientDiagnostics.ButtonClicks.Add(1, new KeyValuePair<string, object?>("demo.action", "increment"), tag);
        Logger.LogInformation("Counter incremented to {Count} on {RenderMode}", currentCount, renderMode);
    }
}
