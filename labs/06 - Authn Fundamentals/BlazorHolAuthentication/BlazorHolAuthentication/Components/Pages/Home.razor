@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity.Name!</p>
        <p>Here are some resources for you:</p>
        <ul>
            <li><a href="/counter">Counter</a></li>
            <li><a href="/fetchdata">Fetch data</a></li>
        </ul>
    </Authorized>
    <NotAuthorized>
        <p>You're not signed in.</p>
        <p><a href="login">Log in</a> to access your resources.</p>
    </NotAuthorized>
</AuthorizeView>
